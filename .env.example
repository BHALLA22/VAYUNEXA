# =========================================================
# VAYUNEXA environment configuration (EXAMPLE FILE)
# Copy this file to ".env" in the repo root and fill in
# real values. NEVER commit the real ".env" file to Git.
# =========================================================

# ---- PostgreSQL ----
POSTGRES_USER=vayunexa
POSTGRES_PASSWORD=vayunexa_dev_password
POSTGRES_DB=vayunexa
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full connection string used by the backend.
# Docker Compose may override the host to "db".
DATABASE_URL=postgresql://vayunexa:vayunexa_dev_password@localhost:5432/vayunexa

# ---- API security ----
# Shared token used by the ESP8266 / simulator for write requests.
API_TOKEN=dev-token-change-me

# ---- Browser CORS ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Weather provider ----
# Open-Meteo requires no API key.
WEATHER_API_PROVIDER=open-meteo
WEATHER_API_KEY=

# Turbine location.
WEATHER_LAT=28.6139
WEATHER_LON=77.2090

# ---- AI model artifacts ----
AI_MODEL_PATH=../ai/models/energy_model.joblib
AI_METRICS_PATH=../ai/models/metrics.json

# ---- Prototype physical constants ----
# Estimated servo energy consumption.
# Replace with a value measured on your actual hardware.
SERVO_ENERGY_MW_PER_DEGREE=5.0

# ---- Misc ----
ENVIRONMENT=development
BACKEND_PORT=8000

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
